{
  "name": "board",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "user:create": "bun src/scripts/create-user.ts",
    "check": "bunx --bun @biomejs/biome check src tests build.ts && bunx --bun tsc --noEmit",
    "fix": "biome check --write src tests build.ts",
    "migrate": "bunx --bun auth@1.7.5 migrate --yes --config src/lib/auth.ts && bun src/scripts/migrate.ts",
    "test": "bun test tests/unit",
    "test:integration": "DATABASE_URL=${TEST_DATABASE_URL:-} bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "mcp": "bun src/mcp/server.ts",
    "media:cleanup": "bun src/scripts/cleanup-media.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@njxqlus/jean-claude-bun-dam-sdk": "^1.0.5",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "better-auth": "^1.7.5",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "perfect-freehand": "^1.2.3",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "@xyflow/react@12.11.6": "patches/@xyflow%2Freact@12.11.6.patch"
  }
}
