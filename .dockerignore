**
!package.json
!bun.lock
!bunfig.toml
!tsconfig.json
!build.ts
!LICENSE
!src/
!src/**
!styles/
!styles/**
!migrations/
!migrations/**
!patches/
!patches/**
# Never include secrets or generated files under an allowed directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules
**/.DS_Store
